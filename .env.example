# Optional dev override: a classic PAT with repo, read:org and project.
# Never prefix credentials with VITE_: they must stay out of the webview bundle.
PLANCHE_TOKEN=

# Public Client ID of your GitHub OAuth App (enable Device Flow).
# Keep token expiration disabled for this OAuth App.
# Included at build time for distributed apps; no client secret is needed.
PLANCHE_GITHUB_CLIENT_ID=

# Optional existing macOS signing identity. Otherwise run bun run setup:signing once.
# Keep the same certificate across builds; ad hoc signing (-) resets Keychain trust.
APPLE_SIGNING_IDENTITY=
