# Optional dev override: a classic PAT with repo, read:org and project.
# Never prefix credentials with VITE_: they must stay out of the webview bundle.
PLANCHE_TOKEN=

# Optional companion for organizations: public Client ID of a GitHub App.
# Enable Device Flow and expiring user tokens; do not request Contents permissions.
# The app needs Projects (organization), Issues and Pull requests: read/write.
PLANCHE_GITHUB_APP_CLIENT_ID=

# Primary OAuth App Client ID for personal projects. Enable Device Flow.
# Requests only project; organization requests use the companion GitHub App.
# Keep token expiration disabled for this OAuth App (the GitHub App uses rotation).
# Included at build time for distributed apps; no client secret is needed.
PLANCHE_GITHUB_CLIENT_ID=

# Optional existing macOS signing identity. Otherwise run bun run setup:signing once.
# Keep the same certificate across builds; ad hoc signing (-) resets Keychain trust.
APPLE_SIGNING_IDENTITY=
