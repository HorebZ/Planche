{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "scripts/**",
      "*.json",
      "app/**",
      "website/**",
      "!!.local",
      "!app/src-tauri",
      "!app/dist",
      "!app/src/ipc/bindings.types.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "useBlockStatements": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["website/**"],
      "html": {
        "formatter": {
          "enabled": true
        }
      }
    }
  ]
}
