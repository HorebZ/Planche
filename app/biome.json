{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"includes": ["src/**", "e2e/**", "scripts/**", "*.ts", "*.json"]
	},
	"css": {
		"parser": { "tailwindDirectives": true }
	},
	"linter": {
		"rules": {
			"nursery": {
				"useSortedClasses": { "level": "error", "fix": "safe", "options": { "functions": ["cn", "cva"] } }
			}
		}
	}
}
