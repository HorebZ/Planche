{
	"name": "planche",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"check:design": "bun scripts/sync-design-tokens.ts --check && bun scripts/check-design.ts",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"check": "bun run typecheck && bun run lint && bun run check:design && bun run test",
		"sync:design": "bun scripts/sync-design-tokens.ts && biome format --write src/styles/tokens.css"
	},
	"dependencies": {
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "5.104.3",
		"@tanstack/react-virtual": "3.14.20",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"lucide-react": "^1.55.0",
		"radix-ui": "^1.8.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.64.0",
		"@tauri-apps/cli": "^2",
		"@types/node": "^26.6.5",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^6.0.2",
		"happy-dom": "21.0.1",
		"typescript": "~6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.4"
	}
}
